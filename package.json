{
  "name": "@red-cup-engineering/searching-filepath-service",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Streams a token search over a tree as cheapest-first NDJSON: filename matches over configured priority paths, then filename matches over the rest of the root, then markdown frontmatter/title matches, then markdown heading matches. Use to find where to look first before committing to a full-text sweep.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/searching-filepath-service.git"
  },
  "exports": "./src/search-file-path.mjs",
  "bin": {
    "search-file-path": "./scripts/search-file-path.mjs"
  },
  "scripts": {
    "check": "node --check src/search-file-path.mjs && node --check scripts/search-file-path.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/filename-token-matching-service": "0.1.1",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.2",
    "@red-cup-engineering/path-walking-service": "0.5.2",
    "@red-cup-engineering/file-type-slicing-service": "0.1.3",
    "@red-cup-engineering/dated-state-writing-service": "0.1.3"
  },
  "files": [
    "package.json",
    "README*",
    "LICENSE*",
    "scripts",
    "src"
  ]
}
